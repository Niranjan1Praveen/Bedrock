generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Prisma 7 no longer accepts `url` here. The migration URL lives in
// prisma.config.ts and the runtime URL is supplied by the driver adapter
// in lib/prisma.ts.
datasource db {
  provider = "postgresql"
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model Post {
  id      String @id @default(cuid())
  slug    String @unique
  title   String
  /// Shown in the index and used as the meta description.
  summary String?
  /// Markdown source. The only stored representation, so changing the
  /// renderer never leaves old posts stale.
  content String

  coverImage String?

  status PostStatus @default(DRAFT)
  /// Set once, on the first publish, and never moved by later edits.
  publishedAt DateTime?
  /// Minutes, computed from word count on save.
  readingTime Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags Tag[] @relation("PostTags")

  /// Matches the only hot query: published posts, newest first.
  @@index([status, publishedAt(sort: Desc)])
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  posts Post[] @relation("PostTags")
}

/// Study material, organised subject -> topic -> document.
///
/// Files live in a private Supabase Storage bucket and are never public: the
/// row stores only the object path, and a short-lived signed URL is minted
/// server-side for each view.
model Subject {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  /// Uploaded cover. When null the UI draws a deterministic cover from the
  /// slug instead, so a subject always has one without needing storage.
  imageUrl    String?
  /// Manual ordering; ties break on name.
  position    Int     @default(0)

  topics    Topic[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Topic {
  id       String @id @default(cuid())
  slug     String
  name     String
  position Int    @default(0)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  documents Document[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  /// Slugs need only be unique inside their subject.
  @@unique([subjectId, slug])
  @@index([subjectId, position])
}

model Document {
  id    String @id @default(cuid())
  slug  String
  title String

  /// Object key inside the private `library` bucket. Not a URL: there is no
  /// public URL for these, by design.
  storagePath String @unique
  sizeBytes   Int
  /// Filled in by the browser after the PDF is first opened, when known.
  pageCount   Int?
  position    Int    @default(0)

  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  uploadedAt DateTime @default(now())
  /// auth.users id of whoever uploaded it. Not a foreign key: auth lives in
  /// another schema that Prisma does not manage.
  uploadedBy String?

  progress DocumentProgress[]

  @@unique([topicId, slug])
  @@index([topicId, position])
}

/// One row per user per document they have marked revised.
///
/// Progress is private to each account: rows are keyed by the auth user id and
/// are never read across users, so the three people with logins each keep their
/// own state. Absence of a row means not revised, which keeps the table small
/// and makes unmarking a delete rather than a flag flip.
model DocumentProgress {
  id String @id @default(cuid())

  /// auth.users id. Not a foreign key, for the same reason as Document.uploadedBy.
  userId String

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  revisedAt DateTime @default(now())

  @@unique([userId, documentId])
  @@index([userId])
  @@index([documentId])
}
